/* Copilot-inspired workspace chrome. Scientific overlays keep their own colors.
 * Match AppTheme.cpp for controls and custom painters that use QPalette.
 * Canvas #0d1117, panels #161b22, raised #21262d, border #30363d,
 * text #e6edf3, muted #8b949e, focus #58a6ff, selection #1f6feb.
 */

QWidget {
    background-color: #0d1117;
    color: #e6edf3;
    font-size: 13px;
}
QMainWindow, QDialog {
    background-color: #0d1117;
}
QMainWindow::separator, QSplitter::handle {
    background-color: #30363d;
    width: 1px;
    height: 1px;
}
QMainWindow::separator:hover, QSplitter::handle:hover {
    background-color: #58a6ff;
}

/* Menus */
QMenuBar {
    background-color: #010409;
    border-bottom: 1px solid #30363d;
    padding: 3px 4px;
}
QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background-color: #21262d;
}
QMenu {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 28px 6px 12px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #1f6feb;
    color: #ffffff;
}
QMenu::item:disabled {
    color: #8b949e;
}
QMenu::separator {
    height: 1px;
    background-color: #30363d;
    margin: 4px 8px;
}

/* Inspector panels and workspace tabs */
QDockWidget {
    background-color: #161b22;
}
QDockWidget::title {
    background-color: #161b22;
    color: #8b949e;
    padding: 9px 12px;
    border-bottom: 1px solid #30363d;
    text-align: left;
    font-weight: 600;
}
QDockWidget::close-button, QDockWidget::float-button {
    background: transparent;
    border: none;
    padding: 3px;
}
QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background-color: #30363d;
}
QDockWidget > QWidget {
    background-color: #161b22;
}
QTabWidget::pane {
    border: none;
    background-color: #0d1117;
}
QTabBar::tab {
    background-color: #161b22;
    color: #8b949e;
    padding: 9px 16px;
    border: none;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:hover {
    background-color: #21262d;
    color: #e6edf3;
}
QTabBar::tab:selected {
    background-color: #0d1117;
    color: #e6edf3;
    border-bottom-color: #58a6ff;
}

/* Buttons */
QPushButton {
    background-color: #21262d;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #30363d;
    border-color: #8b949e;
}
QPushButton:pressed {
    background-color: #161b22;
}
QPushButton:default, QPushButton[accent="true"] {
    background-color: #238636;
    border-color: #2ea043;
    color: #ffffff;
    font-weight: 600;
}
QPushButton:default:hover, QPushButton[accent="true"]:hover {
    background-color: #2ea043;
    border-color: #3fb950;
}
QPushButton:default:pressed, QPushButton[accent="true"]:pressed {
    background-color: #196c2e;
}
QPushButton:flat {
    background: transparent;
    border-color: transparent;
    color: #58a6ff;
}
QPushButton:flat:hover {
    background-color: #21262d;
}
QPushButton:disabled, QPushButton:default:disabled, QPushButton[accent="true"]:disabled {
    background-color: #161b22;
    color: #8b949e;
    border-color: #30363d;
}
QToolButton {
    background: transparent;
    color: #e6edf3;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 5px;
}
QToolButton:hover {
    background-color: #21262d;
}
QToolButton:checked {
    background-color: #1f6feb;
    color: #ffffff;
}
QPushButton:focus, QToolButton:focus {
    border: 1px solid #58a6ff;
}
QToolButton:disabled {
    color: #8b949e;
}

/* Inputs */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit,
QTextEdit, QPlainTextEdit {
    background-color: #0d1117;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 5px 8px;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus,
QDateEdit:focus, QTimeEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #58a6ff;
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    color: #8b949e;
    background-color: #161b22;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox::down-arrow {
    image: url(:/themes/icons/chevron-down.png);
    width: 12px;
    height: 12px;
}
QComboBox QAbstractItemView {
    background-color: #161b22;
    color: #e6edf3;
    border: 1px solid #30363d;
    padding: 4px;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
}
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background: transparent;
    border: none;
    width: 20px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #21262d;
}

/* Checkboxes, sliders, and progress */
QCheckBox, QRadioButton {
    background: transparent;
    spacing: 8px;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: #0d1117;
    border: 1px solid #8b949e;
}
QCheckBox::indicator {
    border-radius: 4px;
}
QRadioButton::indicator {
    border-radius: 8px;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #1f6feb;
    border-color: #58a6ff;
}
QCheckBox::indicator:checked {
    image: url(:/themes/icons/check.png);
}
QRadioButton::indicator:checked {
    image: url(:/themes/icons/check.png);
}
QCheckBox:disabled, QRadioButton:disabled {
    color: #8b949e;
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background-color: #21262d;
    border-color: #30363d;
}
QSlider {
    background: transparent;
}
QSlider::groove:horizontal {
    height: 4px;
    background-color: #30363d;
    border-radius: 2px;
    margin: 0 8px;
}
QSlider::groove:vertical {
    width: 4px;
    background-color: #30363d;
    border-radius: 2px;
    margin: 8px 0;
}
QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px -7px;
    background-color: #e6edf3;
    border-radius: 7px;
}
QSlider::handle:vertical {
    width: 14px;
    height: 14px;
    margin: -7px -5px;
    background-color: #e6edf3;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover, QSlider::handle:vertical:hover {
    background-color: #58a6ff;
}
QSlider::sub-page:horizontal, QSlider::sub-page:vertical {
    background-color: #1f6feb;
    border-radius: 2px;
}
QSlider::groove:horizontal:disabled, QSlider::groove:vertical:disabled,
QSlider::sub-page:horizontal:disabled, QSlider::sub-page:vertical:disabled {
    background-color: #21262d;
}
QSlider::handle:horizontal:disabled, QSlider::handle:vertical:disabled {
    background-color: #484f58;
}
QProgressBar {
    background-color: #21262d;
    color: #e6edf3;
    border: none;
    border-radius: 4px;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #2ea043;
    border-radius: 4px;
}

/* Thin scrollbars */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #484f58;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    min-height: 28px;
}
QScrollBar::handle:horizontal {
    min-width: 28px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background-color: #8b949e;
}
QScrollBar::add-line, QScrollBar::sub-line {
    border: none;
    width: 0;
    height: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* Lists and tables */
QTreeView, QListView, QListWidget, QTableView {
    background-color: #0d1117;
    alternate-background-color: #161b22;
    color: #e6edf3;
    border: none;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
}
QTreeView::item, QListView::item {
    padding: 6px 8px;
    border-radius: 4px;
}
QTreeView::item:hover, QListView::item:hover {
    background-color: #21262d;
}
QTreeView::item:selected, QListView::item:selected {
    background-color: #1f6feb;
    color: #ffffff;
}
QTreeView::branch {
    background: transparent;
}
QHeaderView::section {
    background-color: #161b22;
    color: #8b949e;
    border: none;
    border-bottom: 1px solid #30363d;
    padding: 6px 10px;
    font-weight: 600;
}
QGroupBox {
    background: transparent;
    border: 1px solid #30363d;
    border-radius: 6px;
    margin-top: 16px;
    padding-top: 8px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #8b949e;
    background: transparent;
}
QLabel, QFrame, QScrollArea {
    background: transparent;
}
QLabel[secondary="true"] {
    color: #8b949e;
}
QScrollArea {
    border: none;
}
QScrollArea > QWidget > QWidget {
    background: transparent;
}
QToolTip {
    background-color: #161b22;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 6px 10px;
}
QStatusBar {
    background-color: #010409;
    color: #8b949e;
    border-top: 1px solid #30363d;
}
QStatusBar::item {
    border: none;
}

/* Activity rail */
QToolBar#panelSidebar {
    background-color: #010409;
    border: none;
    border-right: 1px solid #30363d;
    spacing: 3px;
    padding: 8px 2px;
}
QToolBar#panelSidebar QToolButton {
    background: transparent;
    color: #8b949e;
    border: none;
    border-left: 2px solid transparent;
    border-radius: 0;
    padding: 9px 4px;
    min-width: 48px;
    font-size: 10px;
}
QToolBar#panelSidebar QToolButton:hover {
    background-color: #161b22;
    color: #e6edf3;
}
QToolBar#panelSidebar QToolButton:checked {
    background-color: #161b22;
    color: #58a6ff;
    border-left-color: #58a6ff;
}
QToolBar#panelSidebar QToolButton:focus {
    border: 1px solid #58a6ff;
    border-left-width: 2px;
}
QToolBar#panelSidebar QToolButton:disabled {
    color: #484f58;
}
QToolBar#panelSidebar::separator {
    background-color: #30363d;
    height: 1px;
    margin: 8px;
}

/* Command bar and palette */
QWidget#workspaceTopBar {
    background-color: #161b22;
    border-bottom: 1px solid #30363d;
}
QComboBox#workspaceSwitcher {
    background-color: #161b22;
    min-width: 140px;
}
QToolButton#commandLauncher {
    background-color: #0d1117;
    color: #8b949e;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 6px 12px;
    min-width: 160px;
    max-width: 480px;
    text-align: left;
}
QToolButton#commandLauncher:hover, QToolButton#commandLauncher:focus {
    border-color: #58a6ff;
    color: #e6edf3;
}
QDialog#commandPalette {
    background-color: #161b22;
    border: 1px solid #484f58;
    border-radius: 8px;
}
QLineEdit#commandSearch {
    padding: 10px 12px;
    font-size: 14px;
}
QListWidget#commandResults {
    background-color: #161b22;
}
QListWidget#commandResults::item {
    padding: 10px 12px;
}
QLabel#commandPaletteEmpty {
    padding: 12px;
}

/* Workflow and welcome surfaces */
QToolButton[sectionHeader="true"] {
    background-color: #21262d;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 9px 12px;
    font-weight: 600;
    text-align: left;
}
QToolButton[sectionHeader="true"]:hover {
    background-color: #30363d;
}
QToolButton[sectionHeader="true"]:checked {
    background-color: #161b22;
    border-color: #58a6ff;
    color: #58a6ff;
}
ViewerStatsBar {
    background-color: rgba(13, 17, 23, 0.9);
    color: #8b949e;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 11px;
    font-family: "Menlo", "Consolas", monospace;
}
QLabel[emptyState="true"] {
    color: #8b949e;
    font-size: 14px;
    padding: 20px;
}
QListWidget#recentProjects {
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 4px;
}
QLabel#welcomeTitle {
    font-size: 26px;
    font-weight: 600;
}
